# Caddy reverse proxy for Lockwell's public S3/native API port.
#
# Caddy terminates HTTPS automatically and streams request bodies by default,
# which avoids buffering large object uploads to disk. Keep Lockwell's admin
# listener (9001) private; it exposes the admin UI and unauthenticated metrics.

s3.example.com {
	# Set this to the largest single PUT or multipart part your deployment allows.
	request_body {
		max_size 5GB
	}

	reverse_proxy 127.0.0.1:9000 {
		# Preserve the host used by SigV4 and signed URLs. Caddy supplies the
		# X-Forwarded-* headers with the original scheme and client address.
		header_up Host {host}
	}
}

# Do not proxy 127.0.0.1:9001 to the internet. Reach the admin UI and metrics
# over an SSH tunnel or a firewalled private network instead.
