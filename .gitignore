# Never commit real deployment secrets.
.env
*.env
!.env.example

# Local state / backups that may land beside the compose file.
metadata-backup*.bin
lockwell-data/
*.tar.gz

# OpenTofu/Terraform local state and plans. Production state must use an encrypted remote backend.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars
crash.log
