# Copy this file outside source control and pass it to scripts/tofu-init-scaleway.sh.
# Never put access_key, secret_key, session_token, or other credentials here.
bucket = "replace-with-versioned-state-bucket"
key    = "lockwell/non-production/scaleway.tfstate"
region = "fr-par"

endpoints = {
  s3 = "https://s3.fr-par.scw.cloud"
}

use_lockfile                  = true
encrypt                       = true
skip_credentials_validation  = true
skip_region_validation       = true
skip_requesting_account_id   = true
skip_s3_checksum             = true
