# Lockwell deployment. Copy to ".env" and fill in, then:
#   docker compose up -d --build

# Initial S3 credentials, created on first boot (idempotent). This is your root
# S3 access key. Never commit the real .env.
#
# The CHANGE_ME_* values below are SENTINELS: the container refuses to boot while
# they are still in place, so an un-edited copy of this file fails fast instead
# of silently bootstrapping a guessable credential. Generate real ones:
#   ACCESS KEY ID:  openssl rand -hex 12        (or any short opaque id)
#   SECRET KEY:     openssl rand -base64 36     (long, random, >= 16 chars)
LOCKWELL_ROOT_ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY_ID
LOCKWELL_ROOT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
LOCKWELL_ROOT_TENANT=root

# Optional: first admin WEB-UI login (separate from the S3 key above). Set these
# to be able to sign in to the admin UI on port 9001 immediately. Leave unset to
# create the admin user later with `lockwell admin-create`.
LOCKWELL_ADMIN_USERNAME=admin
LOCKWELL_ADMIN_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET
LOCKWELL_ADMIN_ROLE=owner

# Which released binary version to build the local runtime image from. Pin it
# for reproducible deploys; bump it and re-run `docker compose up -d --build` to
# upgrade. See https://github.com/RusticStack/lockwell-deploy/releases for versions.
LOCKWELL_VERSION=0.2.1
# Local tag for the image the Dockerfile produces. Rarely needs changing.
LOCKWELL_IMAGE=lockwell:0.2.1

# Published host ports.
# Front the S3 port with a TLS-terminating reverse proxy (see examples/Caddyfile
# and examples/nginx.conf, or let Coolify/Dokploy do it when you attach a domain).
LOCKWELL_S3_PORT=9000

# Admin UI + Prometheus /metrics. /metrics is UNAUTHENTICATED, so this port is
# bound to localhost only by default. Reach it via SSH tunnel:
#   ssh -L 9001:127.0.0.1:9001 youruser@yourhost   then open http://localhost:9001/admin
# To expose it on a private network instead, set LOCKWELL_ADMIN_BIND=0.0.0.0 and
# firewall the port. Do NOT attach a public domain directly to it.
LOCKWELL_ADMIN_PORT=9001
LOCKWELL_ADMIN_BIND=127.0.0.1
